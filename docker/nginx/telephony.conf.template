# Twilio front of docker/compose.telephony.yaml (nginx substitutes ${PUBLIC_HOST} at start).
#   GET/POST /twiml  -> TwiML that connects the call to wss://<public host>/stream
#   /stream          -> the media-stream WebSocket of `van serve -p twilio` (agent:8765)
# Point the Twilio number's "A call comes in" webhook at https://<public host>/twiml.
# TLS terminates in front of this server (a tunnel such as cloudflared/ngrok, or your proxy).

map $http_upgrade $connection_upgrade {
    default upgrade;
    ""      close;
}

server {
    listen 80;
    server_name _;

    resolver 127.0.0.11 valid=10s ipv6=off;
    set $agent http://agent:8765;

    # PUBLIC_HOST set: that host; empty: the Host header the tunnel forwards.
    set $public_host "${PUBLIC_HOST}";
    if ($public_host = "") {
        set $public_host $http_host;
    }

    location = /twiml {
        default_type text/xml;
        return 200 '<?xml version="1.0" encoding="UTF-8"?><Response><Connect><Stream url="wss://$public_host/stream"/></Connect></Response>';
    }

    location = /stream {
        rewrite ^ / break;
        proxy_pass $agent;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # Liveness only: /ready and /metrics stay on the agent's port, off the public tunnel.
    location = /health {
        proxy_pass $agent;
    }

    location / {
        return 404;
    }
}
