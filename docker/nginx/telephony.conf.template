# Public front of docker/compose.telephony.yaml: only the call routes reach the agent.
#   GET /answer  -> `van serve -p twilio` answers the call with TwiML: <Connect><Stream
#                   url="wss://<public host>/"> plus the call's stream token
#   /            -> the media-stream WebSocket (agent:8765)
#   /health      -> liveness (/ready and /metrics stay on the agent's port, off the tunnel)
# Point the Twilio number's "A call comes in" webhook at https://<public host>/answer
# (method GET; add ?key=<VAN_SERVER_API_KEY> unless PUBLIC_URL lets the agent check
# Twilio's signature). TLS terminates in front of this server (a tunnel such as
# cloudflared/ngrok, or your proxy). Paths and the Host header are passed unchanged: the
# agent builds the stream URL from them and checks Twilio's signature over them.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ""      close;
}

server {
    listen 80;
    server_name _;

    resolver 127.0.0.11 valid=10s ipv6=off;
    set $agent http://agent:8765;

    location = /answer {
        limit_except GET { deny all; }
        proxy_pass $agent;
        proxy_set_header Host $host;
    }

    location = / {
        proxy_pass $agent;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location = /health {
        proxy_pass $agent;
    }

    location / {
        return 404;
    }
}
