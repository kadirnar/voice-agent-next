   "selection": "first 10 files of 2-20 s with distinct sentences, in archive order; sentences with digits skipped",
   "items": [
    {
     "id": "de_de-2003-10004059102127011984",
     "member": "test/10004059102127011984.wav",
     "file": "10004059102127011984.wav",
     "sha256": "1603ed8fcea31a7f32f51d137eaa3516d15aca947898b81a136f4a9732f08ad2",
     "bytes": 1148218,
     "duration": 17.94,
     "gender": "MALE",
     "text": "Für die besten Aussichten auf Hongkong sollten Sie die Insel verlassen und zum gegenüberliegenden Ufer von Kowloon fahren."
    },
    {
     "id": "de_de-1738-10009182821551087671",
     "member": "test/10009182821551087671.wav",
     "file": "10009182821551087671.wav",
     "sha256": "90d0470adf728783e98cc8dddd51e2c2cbf0d6bf360da65f7d2ac5c3e65876aa",
     "bytes": 714298,
     "duration": 11.16,
     "gender": "MALE",
     "text": "Er griff auch alles an, was ins Wasser kam; selbst ein großer Dinosaurier wie der T. Rex war ihm nicht gewachsen."
    },
    {
     "id": "de_de-1849-10014044777125235464",
     "member": "test/10014044777125235464.wav",
     "file": "10014044777125235464.wav",
     "sha256": "13041e21e6a44d30da9595905fbb4367056191a513245b84e64a13449c8d08ea",
     "bytes": 794938,
     "duration": 12.42,
     "gender": "MALE",
     "text": "Wenn Sie den Film „Das Vermächtnis der Tempelritter“ gesehen haben, denken Sie vielleicht, dass auf die Rückseite der Unabhängigkeitserklärung eine Schatzkarte gezeichnet wurde."
    },
    {
     "id": "de_de-1683-10030056357041867775",
     "member": "test/10030056357041867775.wav",
     "file": "10030056357041867775.wav",
     "sha256": "fda294888110e8bc13a0e468033a21f3b0f2f6a6e7efe40c32583c4760a58f0e",
     "bytes": 683578,
     "duration": 10.68,
     "gender": "MALE",
     "text": "Es leben noch viele Männer und Frauen, die ihre Zeit hier überlebt haben, und viele weitere mit Angehörigen, die dort ermordet wurden oder sich zu Tode arbeiteten, Juden und Nichtjuden gleichermaßen."
    },
    {
     "id": "de_de-1739-10058186628567796965",
     "member": "test/10058186628567796965.wav",
     "file": "10058186628567796965.wav",
     "sha256": "8859c90aaeeb54915cc3a7d0010aba564f996f1bc6f393f184a06825d0940090",
     "bytes": 633658,
     "duration": 9.9,
     "gender": "MALE",
     "text": "Die Höhle befindet sich auf der Spitze eines der Berge nördlich von Mekka und ist vom Rest der Welt völlig isoliert."
    },
    {
     "id": "de_de-1796-10058299886985225661",
     "member": "test/10058299886985225661.wav",
     "file": "10058299886985225661.wav",
     "sha256": "4dba8160f102695aa4f5b5407241037e9d91bb6febd1854e7cda499e953abb7a",
     "bytes": 537658,
     "duration": 8.4,
     "gender": "MALE",
     "text": "Dieses Sediment war nötig, um Sandbänke und Strände zu bilden, die als Lebensräume für Wildtiere dienten."
    },
    {
     "id": "de_de-1990-10095057775426831514",
     "member": "test/10095057775426831514.wav",
     "file": "10095057775426831514.wav",
     "sha256": "fd254f62c724d0db0c1e0d288dbe121a4770ecb5b5547fad91d28a967d454499",
     "bytes": 829498,
     "duration": 12.96,
     "gender": "MALE",
     "text": "Blogs können auch dazu beitragen, die Schreibfertigkeiten von Schülern zu verbessern. Zwar haben Schüler am Anfang ihrer Blogerfahrung oft eine schlampige Grammatik und Rechtschreibung, aber das ändert sich normalerweise, wenn es ein Publikum gibt."
    },
    {
     "id": "de_de-1884-10166547362714956625",
     "member": "test/10166547362714956625.wav",
     "file": "10166547362714956625.wav",
     "sha256": "adf91db1187ebac0228f3cabe0be4f18c47c34702a8027793462e5f8485be7dc",
     "bytes": 706618,
     "duration": 11.04,
     "gender": "MALE",
     "text": "Insbesondere wird behauptet, dass man erkennen kann, ob jemand lügt, indem man minimale Veränderungen des Gesichtsausdrucks richtig deutet.x"
    },
    {
     "id": "de_de-1797-10229344228128634115",
     "member": "test/10229344228128634115.wav",
     "file": "10229344228128634115.wav",
     "sha256": "bd32736573baee445faef9d586796c76adfc105dde0c666120e778f5b4ff5838",
     "bytes": 457018,
     "duration": 7.14,
     "gender": "MALE",
     "text": "Jeder nimmt an der Gesellschaft teil und benutzt Transportsysteme. Fast jeder beklagt sich über die Transportsysteme.x"
    },
    {
     "id": "de_de-1862-10240730312646485406",
     "member": "test/10240730312646485406.wav",
     "file": "10240730312646485406.wav",
     "sha256": "c9d1ade20c467adc98fe23fcf31f28292f4b0ee6370babd783e4b22f843c4395",
     "bytes": 1079098,
     "duration": 16.86,
     "gender": "MALE",
     "text": "NextGen ist ein System, von dem die FAA behauptet, dass es Flugzeugen erlauben würde, kürzere Strecken zu fliegen und jedes Jahr Millionen Gallonen an Treibstoff zu sparen und die Kohlenstoffemissionen zu reduzieren."
    }
   ]
